# Cloud Build upload filter. Keep source (sentinel, migrations, frontend/src +
# package manifests, requirements, Dockerfile); drop everything heavy or local.
.git/
.venv/
__pycache__/
*.pyc
*.pyo

frontend/node_modules/
frontend/dist/

.env
.env.*
.claude/
tasks/
scripts/
tests/

