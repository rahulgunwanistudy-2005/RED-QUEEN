# Copy to .env and edit. All USE_REAL_* default False (shim) until GCP access is
# confirmed (SOF-157). Flip a single flag to swap that component to its real path.
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@localhost:5544/sentinel
SENTINEL_SERVER_URL=http://localhost:8099
BASELINE_SCORE=41

USE_REAL_MODEL_ARMOR=0
USE_REAL_VERTEX_GEMINI=0
USE_REAL_GEMMA=0
USE_REAL_CLOUD_RUN=0
USE_REAL_CLOUD_SQL=0
USE_REAL_PUBSUB=0

# GEMINI_API_KEY powers the Gemma red-team GENERATOR (SESSION_8, PATH B) — Gemma is
# reached via the AI Studio Developer API (generativelanguage), a distinct low-sensitivity
# surface from the ADC-authenticated Vertex surfaces above. Set it AND USE_REAL_GEMMA=1 to
# turn the real generator on; any failure falls back to the offline seed (demo can't break).
GEMINI_API_KEY=
# Gemma generator model + per-call timeout (falls back to offline seed past the timeout).
# gemma-4-26b-a4b-it is verified on AI Studio (generateContent). It is a thinking model.
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_S=30

# Gemini model posture (SESSION_7 — hackathon requires 3.5+). The range brain drives the
# hardener, verifier, and multimodal guard; the vulnerable target agent runs the smaller
# model. gemini-3.x publisher models serve on Vertex's `global` endpoint, so the Gemini
# client location is `global` while Model Armor / Memory Bank / Cloud SQL stay regional.
VERTEX_GEMINI_MODEL=gemini-3.5-flash
TARGET_AGENT_MODEL=gemini-3.5-flash-lite
VERTEX_GEMINI_LOCATION=global

# M2: the firewalled verifier's OWN restricted role (SOF-170). Leave unset — it is
# derived from DATABASE_URL automatically (same host, sentinel_verifier creds). The
# role + grants are created by migrations/003_hardening.sql. On real GCP, point this
# at the verifier service account's Cloud SQL credentials — no code change.
# VERIFIER_DATABASE_URL=postgresql+psycopg2://sentinel_verifier:verifierpass@localhost:5544/sentinel
